PORT=3000
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# ─── Proveedores de IA (opciones GRATUITAS) ────────────────────────────────────
# Elige uno o varios separados por coma. Si el primero falla, prueba el siguiente.
# Opciones: gemini (recomendado), groq, ollama (local, sin límites)
LLM_PROVIDERS=gemini,ollama

# ─── Gemini (Google) - GRATIS con límites generosos ────────────────────────────
# Obtén tu clave gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_gemini_aqui
# GEMINI_MODEL=gemini-1.5-flash         # opcional: modelo por defecto (usa este)
# GEMINI_MODEL=gemini-1.5-pro           # opcional: más preciso pero más lento
# GEMINI_TIMEOUT_MS=25000               # opcional: timeout en milisegundos

# ─── Groq - GRATIS, muy rápido ──────────────────────────────────────────────────
# Obtén tu clave gratis en: https://console.groq.com/keys
# GROQ_API_KEY=tu_clave_groq_aqui
# GROQ_MODEL=llama-3.3-70b-versatile    # opcional: modelo por defecto
# GROQ_TIMEOUT_MS=25000                 # opcional: timeout

# ─── Ollama - LOCAL y GRATIS (sin límites, sin internet) ────────────────────────
# Instala Ollama desde: https://ollama.com/download
# Luego ejecuta: ollama pull qwen2.5-coder:3b
# No necesita API key, corre en tu computadora
# OLLAMA_MODEL=qwen2.5-coder:3b         # opcional: modelo por defecto
# OLLAMA_BASE_URL=http://localhost:11434/v1  # opcional: si cambias el puerto
# OLLAMA_TIMEOUT_MS=120000              # opcional: timeout (más alto para local)

# ─── OpenAI - DE PAGO (no recomendado si quieres gratis) ───────────────────────
# OPENAI_API_KEY=tu_clave_openai_aqui
# OPENAI_MODEL=gpt-4o-mini